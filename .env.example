# =============================================================================
# AI Workforce Platform - Environment Configuration
# Copy to .env and fill in values for your environment
# =============================================================================

# --- Application ---
APP_NAME="AI Workforce"
APP_ENV=development            # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=false

# --- Security ---
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEY_HEADER=X-API-Key
INTERNAL_API_KEY=internal-svc-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database ---
POSTGRES_DSN=postgresql+asyncpg://workforce:workforce@localhost:5432/workforce
REDIS_URL=redis://localhost:6379/0

# --- Vector store ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=workforce_knowledge

# --- LLM Providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_MODEL=gpt-4.1
DEFAULT_FAST_MODEL=gpt-4.1-mini
DEFAULT_REASONING_MODEL=claude-opus-4-7-20251001

# --- Voice Providers ---
# Speech-to-Text
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
GOOGLE_APPLICATION_CREDENTIALS=

# Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Realtime / streaming
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Default voice provider chain (comma-separated, fallback order)
VOICE_STT_PROVIDER=deepgram
VOICE_TTS_PROVIDER=elevenlabs
VOICE_REALTIME_PROVIDER=openai_realtime

# --- MCP integrations (URLs / tokens for connectors) ---
MCP_CRM_URL=
MCP_CRM_TOKEN=
MCP_HRIS_URL=
MCP_HRIS_TOKEN=
MCP_ERP_URL=
MCP_ERP_TOKEN=
MCP_TICKETING_URL=
MCP_TICKETING_TOKEN=
MCP_KNOWLEDGE_URL=
MCP_KNOWLEDGE_TOKEN=
MCP_CALENDAR_URL=
MCP_CALENDAR_TOKEN=
MCP_EMAIL_URL=
MCP_EMAIL_TOKEN=
MCP_ANALYTICS_URL=
MCP_ANALYTICS_TOKEN=

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-workforce
PROMETHEUS_PORT=9090

# --- Rate limits ---
RATE_LIMIT_PER_MIN=120
